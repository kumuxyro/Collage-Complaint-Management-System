# ========================================================
# College Complaint Management System - Backend Environment
# ========================================================

PORT=3000
NODE_ENV=development

# Authoritative SQLite Database Path
DATABASE_PATH=data/college-cms.sqlite

# Session & Token Secrets
SESSION_SECRET=replace-with-your-secure-session-secret-at-least-32-chars

# CORS / Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000

# Email Integration Boundary (Placeholder)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.college.edu
EMAIL_PORT=587
EMAIL_USER=complaints@college.edu
EMAIL_PASSWORD=placeholder-password-never-commit-secrets
EMAIL_FROM="College Grievance Redressal <complaints@college.edu>"
