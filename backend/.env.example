# ========================================================
# College Complaint Management System - Backend Environment
# ========================================================

# Authoritative SQLite Database Path
DATABASE_PATH=data/college-cms.sqlite

# Session & Token Secret
SESSION_SECRET=replace-with-your-secure-session-secret-at-least-32-chars

# CORS / Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000

# Jira Cloud Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=CMS
