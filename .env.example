# ========================================================
# College Complaint Management System - Environment Variables
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
VITE_API_BASE_URL=/api

# SQLite Database Location
DATABASE_PATH=server/data/college-cms.sqlite

# Authentication & Session Secrets
SESSION_SECRET=replace-with-your-secure-session-secret-at-least-32-chars

# CORS / Frontend Allowed Origin
FRONTEND_ORIGIN=http://localhost:3000

# Email Service Provider (Placeholder - not committed with secrets)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.college.edu
EMAIL_PORT=587
EMAIL_USER=complaints@college.edu
EMAIL_PASSWORD=placeholder-password-never-commit-secrets
EMAIL_FROM="College Grievance Redressal <complaints@college.edu>"

# AI Studio Applet Settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
